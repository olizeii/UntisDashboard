# ─── WebUntis Zugang ───────────────────────────────────────────────
# Kopiere diese Datei nach .env.local und trage deine Daten ein.
# .env.local wird NICHT committet. Die Werte werden nur serverseitig gelesen.

# Server-Host deiner Schule (aus der WebUntis-URL), z. B. "mese.webuntis.com"
UNTIS_SERVER=
# Schulname wie in der URL (?school=...), z. B. "htl-donaustadt"
UNTIS_SCHOOL=
# Benutzername (idealerweise ein eigener Lese-Account mit Rechten auf Lehrer-/Raum-Stundenpläne)
UNTIS_USERNAME=
# Passwort ...
UNTIS_PASSWORD=
# ... ODER App-Secret (WebUntis → Profil → Freigaben → "Anzeigen"). Hat Vorrang vor dem Passwort.
UNTIS_SECRET=

# ─── Optional ──────────────────────────────────────────────────────
# Demo-Modus mit generierten Testdaten (keine Zugangsdaten nötig)
UNTIS_MOCK=false
# Zeitzone der Schule – wichtig, wenn der Server in UTC läuft (z. B. Vercel)
UNTIS_TIMEZONE=Europe/Vienna
# Client-Name, der an WebUntis übermittelt wird
UNTIS_CLIENT_NAME=untis-dashboard
# Timeout pro Untis-Request in Millisekunden
UNTIS_TIMEOUT_MS=15000
# Max. parallele Requests beim Zusammensetzen der Tagesübersicht
UNTIS_MAX_CONCURRENCY=6

# Lehrerverzeichnis für volle Namen, falls WebUntis nur Kürzel liefert (z. B. bei Schüler-Accounts).
# Die Kürzel werden per Namensähnlichkeit zugeordnet. Format wie die Seite der HTL Hollabrunn.
# Beispiel: https://www.htl-hl.ac.at/services/teachers/teachers.php
TEACHER_DIRECTORY_URL=
# Manuelle Zuordnungen (haben Vorrang), Format: "KÜRZEL=Nachname Vorname; KÜRZEL2=…"
UNTIS_TEACHER_NAMES=

# Zugriffsschutz für das Dashboard (HTTP Basic Auth). Leer = kein Schutz.
# Dringend empfohlen, sobald die App öffentlich erreichbar ist!
DASHBOARD_USER=
DASHBOARD_PASSWORD=
